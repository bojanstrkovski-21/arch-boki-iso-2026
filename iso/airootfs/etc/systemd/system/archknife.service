[Unit]
Description=archknife Arch Linux Installer
After=network.target
ConditionPathExists=/usr/local/bin/archknife

[Service]
Type=idle
ExecStart=/usr/local/bin/archknife
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
